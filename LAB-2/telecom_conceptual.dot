rel3 [shape=diamond,fillcolor="#ffe5c9",label="надається як"];
service -> rel3 [label="1"]; rel3 -> contract_service [label="N"];
rel4 [shape=diamond,fillcolor="#ffe5c9",label="має платіж"];
